@{
}
@model DotNetMVCEF.Models.AddProduct //importing AddProduct.cs
<h1>Add Prduct</h1>
<form method="post" enctype="multipart/form-data" class="w-75 mx-auto">
    <div class="mb-3">
        <label for="Name" class="form-label">Enter Product Name: </label>
        <input type="text" class="form-control" id="Name" asp-for="Name" />
    </div>
    <div class="mb-3">
        <label for="Description" class="form-label">Enter Product Description: </label>
        <input type="text" class="form-control" id="Description" asp-for="Description" />
    </div>
    <div class="mb-3">
        <label for="Price" class="form-label">Enter Product Price: </label>
        <input type="number" step="0.5" class="form-control" id="Price" asp-for="Price" />
    </div>
    <div class="mb-3">
        <label for="ImageFile" class="form-label">Product Image (optional):</label>
        <input type="file" class="form-control" id="ImageFile" asp-for="ImageFile" accept="image/png, image/jpeg, image/webp" />
        <div class="form-text">JPG, PNG, or WEBP only, max 2MB.</div>
        <img id="imagePreview" src="#" alt="Preview" class="mt-2 d-none" style="max-width: 200px; max-height: 200px;" />
    </div>
    <div class="mb-3">
        <input type="submit" class="btn btn-primary d-block mx-auto" value="Save" />
    </div>
</form>

@section Scripts {
    <script>
        const imageInput = document.getElementById('ImageFile');
        const preview = document.getElementById('imagePreview');

        imageInput.addEventListener('change', function () {
            const file = this.files[0];   

            if (!file) {
                preview.classList.add('d-none');  //tp hide preview
                return;
            }

            // FileReader browser API hai -- file ko disk se seedha JS mein padh sakta hai,
            // bina server ko kuch bheje (yeh purely client-side preview hai)
            const reader = new FileReader();

            reader.onload = function (e) {
                preview.src = e.target.result;       // e.target.result ek base64 data-URL hoti hai
                preview.classList.remove('d-none');   // ab image dikha do
            };

            reader.readAsDataURL(file);   // yeh reader.onload ko trigger karega jab padhna complete ho
        });
    </script>
}